[pager]
	aliases = false
	last = false
	lg = false
	sl = false
	spop = false

[alias]
	ap = add --patch
	bd = branch-delete # see .local/script/git-branch-delete
	bp = branch-prune # see .local/script/git-branch-prune
	br = branch --sort committerdate -vv
	cb = checkout -b
	co = checkout
	cp = cherry-pick
	dc = diff --cached
	gl = config --global --list --includes
	lg = log --max-count 25 --oneline --reverse
	pu = !"git push --set-upstream \"${1:-origin}\" \"${2:-$(git branch --show-current)}\" && :"
	sl = stash list
	sm = show --diff-filter=M
	st = status --show-stash

	wip = commit --message="WIP"

	cina = commit --no-edit --amend
	curr = branch --show-current
	last = log --max-count 1 --pretty=fuller
	root = rev-parse --show-toplevel
	spop = !"git stash pop && git stash list && :"

	aliases = config --get-regexp '^alias\\.'
	unstage = restore --staged
