# global ignore files in home directories
.DS_Store

# ignore user-dirs
/Desktop/
/Documents/
/Downloads/
/Music/
/Pictures/
/Public/
/Templates/
/Videos/

# ignore linux and macos known directories and files
/.Trash/
/Applications/
/Library/
/Movies/
/snap/

/.CFUserTextEncoding
/.sudo_as_admin_successful

# ignore unsupported dirs and files
/.cups/
/.ssh/
