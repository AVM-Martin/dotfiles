	email = avmm.martin+github@gmail.com
	signingkey = 566629832395B5EC74C74E0C25F846A221B3F159

[advice]
	addEmptyPathspec = false
	skippedCherryPicks = false

[branch]
	sort = -committerdate

[color]
	ui = auto

[commit]
	gpgSign = true
	template = ~/.config/git/commit_message

[core]
	eol = lf
	autocrlf = false
	excludesFile = ~/.config/git/ignore
	attributesFile = ~/.config/git/attributes

[diff]
	algorithm = histogram

[fetch]
	prune = true
	pruneTags = true

[init]
	defaultBranch = main

[log]
	date = iso8601-strict

[pager]
	branch = false

[pull]
	rebase = true

[push]
	default = simple
	followTags = true

[rebase]
	autoStash = true

[status]
	relativePaths = true
	showStash = false

[tag]
	gpgSign = true
	sort = -version:refname

[versionsort]
	suffix = -

[include]
	path = ~/.config/git/config-alias.gitconfig
	path = ~/.config/git/config-url.gitconfig

# gitbare-related config
[includeIf "gitdir:~/.local/share/dotfiles/bare.git"]
	path = ~/.config/git/dotfiles-gitbare.gitconfig

# yadm-related config
[includeIf "gitdir:~/.local/share/yadm/repo.git"]
	path = ~/.config/git/dotfiles-gitbare.gitconfig

# local config
[include]
	path = ~/.config/git/local.gitconfig
